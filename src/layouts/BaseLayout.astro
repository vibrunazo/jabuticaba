---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { type Locale, locales, localeTags, t } from "../i18n/ui.ts";

interface Props {
  locale: Locale;
  /** The same page in every locale, e.g. { pt: "/", en: "/en/" }. Used for hreflang and the language switch. */
  alternates: Record<Locale, string>;
  title?: string;
}

const { locale, alternates, title } = Astro.props;
const siteName = t(locale, "site.name");
const pageTitle = title ? `${title} · ${siteName}` : siteName;
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t(locale, "site.tagline")} />
    <title>{pageTitle}</title>
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={localeTags[l]} href={new URL(alternates[l], Astro.site)} />
      ))
    }
  </head>
  <body class="bg-surface font-sans text-ink antialiased">
    <SiteHeader locale={locale} alternates={alternates} />
    <slot />
    <SiteFooter locale={locale} />
  </body>
</html>
