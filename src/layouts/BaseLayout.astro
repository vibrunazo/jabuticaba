---
import "../styles/global.css";
import FontFaces from "../components/FontFaces.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { type Locale, locales, localeTags, t } from "../i18n/ui.ts";

interface Props {
  locale: Locale;
  /** The same page in each locale that has it, e.g. { pt: "/", en: "/en/" }. Used for hreflang and the language switch. */
  alternates: Partial<Record<Locale, string>>;
  /** Overrides the site description in the meta tags. */
  description?: string;
  title?: string;
}

const { locale, alternates, title, description } = Astro.props;
const siteName = t(locale, "site.name");
const pageTitle = title ? `${title} · ${siteName}` : siteName;
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <FontFaces />
    <meta name="description" content={description ?? t(locale, "site.description")} />
    <title>{pageTitle}</title>
    <!-- Applies the theme before first paint (no flash). Saved choice first, else the system setting. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const system = window.matchMedia("(prefers-color-scheme: dark)");
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const apply = () => {
          root.dataset.theme =
            saved === "light" || saved === "dark" ? saved : system.matches ? "dark" : "light";
        };
        apply();
        system.addEventListener("change", () => {
          try {
            saved = localStorage.getItem("theme");
          } catch {}
          apply();
        });
      })();
    </script>
    {
      locales.flatMap((l) => {
        const href = alternates[l];
        return href ? [<link rel="alternate" hreflang={localeTags[l]} href={new URL(href, Astro.site)} />] : [];
      })
    }
  </head>
  <body class="bg-surface font-sans text-ink antialiased">
    <!-- Dark band: site header plus the page's title area ("hero" slot). -->
    <div class="band-texture bg-band text-band-ink">
      <SiteHeader locale={locale} alternates={alternates} />
      <slot name="hero" />
    </div>
    <!-- The flag stripe separates the band from the content. -->
    <div class="flex h-1.5" aria-hidden="true">
      <span class="flex-1 bg-brand-green"></span>
      <span class="flex-1 bg-brand-yellow"></span>
      <span class="flex-1 bg-brand-navy dark:bg-ink-muted"></span>
    </div>
    <slot />
    <SiteFooter locale={locale} />
  </body>
</html>
