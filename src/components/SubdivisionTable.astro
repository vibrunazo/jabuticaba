---
/**
 * Presence by state or province. Descriptive only (not scored). Shown as a table
 * until subdivision geometry is added to the geo build.
 */
import { levelRangeLabel } from "../i18n/labels.ts";
import { type Locale, t } from "../i18n/ui.ts";
import type { NumberedSource, SubdivisionRow } from "../site/item-detail.ts";
import SourceRefs from "./SourceRefs.astro";

interface Props {
  locale: Locale;
  rows: readonly SubdivisionRow[];
  sources: readonly NumberedSource[];
}

const { locale, rows, sources } = Astro.props;
---

{
  rows.length > 0 && (
    <div class="mt-8">
      <h3 class="font-mono text-xs uppercase tracking-wider text-ink-muted">
        {t(locale, "item.subdivisionsTitle")}
      </h3>
      <table class="mt-3 w-full text-left text-sm">
        <thead class="sr-only">
          <tr>
            <th scope="col">{t(locale, "item.tablePlace")}</th>
            <th scope="col">{t(locale, "item.tablePresence")}</th>
            <th scope="col">{t(locale, "item.tableSources")}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-rule align-top">
              <td class="py-2 pr-4">
                <span class="text-ink">{row.name}</span>
                <span class="ml-2 font-mono text-xs text-ink-muted">{row.subdivision}</span>
                {row.note && <p class="mt-0.5 text-xs text-ink-muted">{row.note}</p>}
              </td>
              <td class="py-2 pr-4 text-ink-muted">{levelRangeLabel(locale, row.low, row.high)}</td>
              <td class="py-2">
                <SourceRefs refs={row} sources={sources} locale={locale} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
