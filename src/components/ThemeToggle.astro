---
/**
 * Light/dark theme switch. Hidden until its script runs, so pages without
 * JavaScript never show a button that does nothing.
 * The theme is applied before first paint by the inline script in BaseLayout.astro.
 */
import { type Locale, t } from "../i18n/ui.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = t(locale, "nav.toggleTheme");
---

<button
  type="button"
  data-theme-toggle
  hidden
  aria-label={label}
  title={label}
  class="rounded-sm p-1 opacity-80 hover:opacity-100"
>
  <!-- Moon: shown in the light theme (switches to dark). -->
  <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <!-- Sun: shown in the dark theme (switches to light). -->
  <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = "theme";
  const root = document.documentElement;

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const sync = () => button.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
    sync();
    button.hidden = false;
    button.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        // Storage can be unavailable (private mode); the choice then lasts for this page only.
      }
      sync();
    });
  }
</script>
