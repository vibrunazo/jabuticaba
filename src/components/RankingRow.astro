---
/**
 * One ranking entry, as a fixed-size card: cover image, a one-line title, a
 * three-line summary, and the score with its error bar along the bottom.
 * Content is clipped to the card, never the other way around; the schema keeps
 * titles and summaries short enough to fit (docs/design/02-content-schema.md).
 * Category, badges and other details live on the item page.
 */
import { Image } from "astro:assets";
import { format, type Locale, t } from "../i18n/ui.ts";
import { coverImage } from "../site/content.ts";
import type { RankingRow } from "../site/ranking.ts";
import ScoreErrorBar from "./ScoreErrorBar.astro";

interface Props {
  row: RankingRow;
  locale: Locale;
  /** Load the image immediately (cards visible without scrolling). */
  eager?: boolean;
}

const { row, locale, eager = false } = Astro.props;
const scoreLabel = format(locale, "ranking.scoreLabel", {
  score: row.score.point,
  low: row.score.low,
  high: row.score.high,
});
const textLang = row.untranslated ? "pt-BR" : undefined;
const cover = row.image && coverImage(row.id, row.image.file);
---

<li
  class="group relative flex flex-col overflow-hidden rounded-md border border-rule bg-surface-raised shadow-sm transition hover:border-ink-muted hover:shadow-md motion-safe:hover:-translate-y-0.5"
>
  <div class="relative aspect-3/2 bg-surface-sunken">
    {
      cover && row.image && (
        <Image
          src={cover}
          alt={row.image.alt}
          widths={[400, 800]}
          sizes="(min-width: 1152px) 360px, (min-width: 1024px) 31vw, (min-width: 640px) 48vw, 100vw"
          loading={eager ? "eager" : "lazy"}
          class="size-full object-cover"
        />
      )
    }
    <span class="absolute top-3 left-3 rounded-sm bg-surface/90 px-2 py-0.5 font-mono text-xs text-heading">
      {format(locale, "ranking.rank", { rank: row.rank })}
    </span>
  </div>

  <div class="flex flex-col p-4">
    <h2 class="h-7 truncate font-serif text-lg leading-7 font-semibold text-heading" lang={textLang}>
      <a href={row.href} class="after:absolute after:inset-0 group-hover:text-accent">
        {row.title}
      </a>
    </h2>
    <p class="mt-1 line-clamp-3 h-15 text-sm leading-5 text-ink-muted" lang={textLang}>
      {row.summary}
    </p>

    <div class="mt-4 flex items-baseline justify-between gap-3">
      <span class="font-mono text-xs tracking-wider text-ink-muted uppercase">{t(locale, "item.index")}</span>
      <span class="text-2xl leading-none font-semibold text-heading" aria-hidden="true">
        {row.score.point}<span class="text-sm font-normal text-ink-muted">%</span>
      </span>
    </div>
    <div class="mt-3 px-1">
      <ScoreErrorBar low={row.score.low} point={row.score.point} high={row.score.high} label={scoreLabel} />
    </div>
  </div>
</li>
