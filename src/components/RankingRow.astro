---
import { categoryLabel } from "../i18n/labels.ts";
import { format, type Locale, t } from "../i18n/ui.ts";
import type { RankingRow } from "../site/ranking.ts";
import Badge from "./Badge.astro";
import ScoreErrorBar from "./ScoreErrorBar.astro";

interface Props {
  row: RankingRow;
  locale: Locale;
}

const { row, locale } = Astro.props;
const scoreLabel = format(locale, "ranking.scoreLabel", {
  score: row.score.point,
  low: row.score.low,
  high: row.score.high,
});
const textLang = row.untranslated ? "pt-BR" : undefined;
---

<li class="group relative flex flex-wrap items-start gap-x-5 gap-y-3 border-b border-rule py-5">
  <span class="w-8 shrink-0 pt-1 text-right font-mono text-sm tabular-nums text-ink-muted">
    {row.rank}
  </span>
  <div class="min-w-0 flex-1">
    <h2 class="font-serif text-xl font-semibold leading-snug text-heading" lang={textLang}>
      <a href={row.href} class="after:absolute after:inset-0 group-hover:text-accent">
        {row.title}
      </a>
    </h2>
    <p class="mt-1 text-sm leading-relaxed text-ink-muted" lang={textLang}>{row.summary}</p>
    <div class="mt-2.5 flex flex-wrap gap-1.5">
      <Badge>{categoryLabel(locale, row.category)}</Badge>
      <Badge>{format(locale, "badge.evidenceGrade", { grade: row.evidenceGrade })}</Badge>
      {row.hiddenJabuticaba && <Badge tone="accent">{t(locale, "badge.hiddenJabuticaba")}</Badge>}
      {row.untranslated && <Badge>{t(locale, "badge.untranslated")}</Badge>}
      {row.status === "mock" && <Badge tone="warning">{t(locale, "badge.mock")}</Badge>}
      {row.status === "draft" && <Badge tone="warning">{t(locale, "badge.draft")}</Badge>}
    </div>
  </div>
  <div class="w-full pl-13 sm:w-36 sm:pl-0">
    <p class="text-right text-2xl font-semibold tabular-nums text-heading" aria-hidden="true">
      {row.score.point}<span class="text-base font-normal text-ink-muted">%</span>
    </p>
    <div class="mt-1.5 px-1">
      <ScoreErrorBar
        low={row.score.low}
        point={row.score.point}
        high={row.score.high}
        label={scoreLabel}
      />
    </div>
  </div>
</li>
