---
import { formatPartialDate, formatRange } from "../i18n/format.ts";
import { categoryLabel } from "../i18n/labels.ts";
import { defaultLocale, format, type Locale, localizedPath, t } from "../i18n/ui.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { METHODOLOGY_VERSION } from "../scoring/constants.ts";
import { renderCitations, resolveItemLinks } from "../site/citations.ts";
import {
  loadItemTexts,
  loadReference,
  loadRenderedBody,
  loadVisibleItems,
} from "../site/content.ts";
import { buildItemDetail, itemHref } from "../site/item-detail.ts";
import Badge from "./Badge.astro";
import PresenceTable from "./PresenceTable.astro";
import ScoreBreakdown from "./ScoreBreakdown.astro";
import ScoreScale from "./ScoreScale.astro";
import SectionHeading from "./SectionHeading.astro";
import SourceList from "./SourceList.astro";
import SubdivisionTable from "./SubdivisionTable.astro";
import WorldMap from "./WorldMap.astro";

interface Props {
  locale: Locale;
  itemId: string;
}

const { locale, itemId } = Astro.props;
const visibleItems = await loadVisibleItems();
const texts = await loadItemTexts();
const reference = loadReference();
const item = visibleItems.find((i) => i.id === itemId);
const detail =
  item &&
  buildItemDetail({
    item,
    locale,
    visibleItems,
    texts,
    places: reference.places,
    subdivisions: reference.subdivisions,
  });
if (!detail) {
  throw new Error(`No ${locale} page data for item "${itemId}".`);
}

const { text, score } = detail;
const visibleIds = new Set(visibleItems.map((i) => i.id));
const hrefFor = (id: string) => {
  const target =
    texts.find((x) => x.itemId === id && x.locale === locale) ??
    texts.find((x) => x.itemId === id && x.locale === defaultLocale);
  return target && visibleIds.has(id) ? itemHref(target.locale, target.text.slug) : undefined;
};
const numbers = new Map(detail.sources.map((s) => [s.source.id, s.number]));
const bodyHtml = resolveItemLinks(
  renderCitations(await loadRenderedBody(itemId, locale), numbers),
  hrefFor,
);
const scoreLabel = format(locale, "ranking.scoreLabel", {
  score: score.score.point,
  low: score.score.low,
  high: score.score.high,
});
const since = detail.item.since;
const sinceText =
  since === undefined ? undefined : typeof since === "number" ? String(since) : `${since.min}–${since.max}`;
const eyebrow = [
  categoryLabel(locale, detail.item.category),
  format(locale, "item.rankOf", { rank: detail.rank, total: detail.total }),
  sinceText && format(locale, "item.since", { year: sinceText }),
].filter(Boolean);

let section = 0;
const next = () => ++section;
---

<BaseLayout locale={locale} alternates={detail.alternates} title={text.title} description={text.summary}>
  <!-- Same outer width as the header (left edges line up); the content itself stays readable. -->
  <main class="mx-auto max-w-6xl px-4 pt-8"><div class="max-w-4xl">
    <a
      href={localizedPath(locale, "/")}
      class="font-mono text-xs uppercase tracking-wider text-ink-muted hover:text-accent"
    >
      ← {t(locale, "nav.backToRanking")}
    </a>

    <header class="mt-6">
      <p class="font-mono text-xs uppercase tracking-wider text-accent">{eyebrow.join(" · ")}</p>
      <h1 class="mt-3 max-w-3xl font-serif text-4xl font-semibold leading-tight tracking-tight text-heading sm:text-5xl">
        {text.title}
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">{text.summary}</p>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {detail.item.status === "mock" && <Badge tone="warning">{t(locale, "badge.mock")}</Badge>}
        {detail.item.status === "draft" && <Badge tone="warning">{t(locale, "badge.draft")}</Badge>}
        {detail.hiddenJabuticaba && <Badge tone="accent">{t(locale, "badge.hiddenJabuticaba")}</Badge>}
        {text.translationStatus === "machine" && <Badge>{t(locale, "item.machineTranslation")}</Badge>}
      </div>
    </header>

    <section class="mt-8 grid gap-6 rounded-sm border border-rule bg-surface-raised p-6 sm:grid-cols-3" aria-label={t(locale, "item.index")}>
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-ink-muted">{t(locale, "item.index")}</p>
        <p class="mt-1 text-6xl font-semibold tracking-tight text-heading">
          {score.score.point}<span class="text-3xl font-normal text-ink-muted">%</span>
        </p>
        <p class="mt-1 text-sm text-ink-muted">
          {format(locale, "item.rangeLabel", { range: formatRange(locale, score.score.low, score.score.high) })}
        </p>
      </div>
      <div class="flex flex-col justify-between gap-6 sm:col-span-2">
        <div class="px-2 pt-2">
          <ScoreScale low={score.score.low} point={score.score.point} high={score.score.high} label={scoreLabel} />
        </div>
        <div class="flex items-start gap-3">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-sm border border-rule font-mono text-lg font-medium text-heading">
            {detail.evidenceGrade}
          </span>
          <p class="text-sm text-ink-muted">
            <span class="font-medium text-ink">{t(locale, "item.evidenceGrade")}.</span>
            {" "}{t(locale, "item.evidenceGradeHint")}
          </p>
        </div>
      </div>
    </section>

    <div class="mt-14 space-y-14">
      <section>
        <SectionHeading number={next()} id="definition">{t(locale, "item.definitionTitle")}</SectionHeading>
        <p class="mt-4 max-w-3xl border-l-2 border-accent pl-4 font-serif text-xl leading-relaxed text-ink">
          {text.definition}
        </p>
      </section>

      {
        bodyHtml.trim() && (
          <section>
            <SectionHeading number={next()} id="context">{t(locale, "item.articleTitle")}</SectionHeading>
            <div class="prose-body mt-4 max-w-2xl" set:html={bodyHtml} />
          </section>
        )
      }

      <section>
        <SectionHeading number={next()} id="map">{t(locale, "item.mapTitle")}</SectionHeading>
        {detail.presence.length === 0 && <p class="mt-4 text-ink-muted">{t(locale, "item.mapAlone")}</p>}
        <div class="mt-4">
          <WorldMap locale={locale} presence={detail.presence} />
        </div>
        <PresenceTable locale={locale} rows={detail.presence} sources={detail.sources} placeCount={score.placeCount} />
        <SubdivisionTable locale={locale} rows={detail.subdivisions} sources={detail.sources} />
      </section>

      <section>
        <SectionHeading number={next()} id="breakdown">{t(locale, "item.breakdownTitle")}</SectionHeading>
        <ScoreBreakdown detail={detail} />
      </section>

      <section>
        <SectionHeading number={next()} id="sources">{t(locale, "item.sourcesTitle")}</SectionHeading>
        <SourceList locale={locale} sources={detail.sources} />
      </section>

      {
        detail.related.length > 0 && (
          <section>
            <SectionHeading number={next()} id="related">{t(locale, "item.relatedTitle")}</SectionHeading>
            <ul class="mt-4 flex flex-wrap gap-2">
              {detail.related.map((link) => (
                <li>
                  <a
                    href={link.href}
                    lang={link.lang}
                    class="inline-block rounded-sm border border-rule px-3 py-1.5 font-serif text-base text-heading hover:border-accent hover:text-accent"
                  >
                    {link.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <p class="mt-14 border-t border-rule pt-4 font-mono text-xs text-ink-muted">
      {format(locale, "item.lastReviewed", {
        date: formatPartialDate(locale, detail.item.lastReviewed),
        version: detail.item.methodologyVersion || METHODOLOGY_VERSION,
      })}
    </p>
  </div></main>
</BaseLayout>
