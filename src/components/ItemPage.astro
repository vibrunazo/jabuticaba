---
/**
 * Item detail page, laid out like a research report:
 * - the dark band holds the tags, title, summary and review date;
 * - the main column starts with the map, then definition, article, breakdown, sources;
 * - the sidebar holds the score, the cover image, a fact sheet and an "on this page"
 *   list that stays in view while scrolling (on phones it collapses into "Jump to…").
 */
import { Image } from "astro:assets";
import { formatPartialDate, formatRange } from "../i18n/format.ts";
import { categoryLabel } from "../i18n/labels.ts";
import { defaultLocale, format, type Locale, localizedPath, t } from "../i18n/ui.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderCitations, resolveItemLinks } from "../site/citations.ts";
import {
  coverImage,
  loadItemTexts,
  loadReference,
  loadRenderedBody,
  loadVisibleItems,
} from "../site/content.ts";
import { buildItemDetail, itemHref } from "../site/item-detail.ts";
import Pill from "./Pill.astro";
import PresenceTable from "./PresenceTable.astro";
import ScoreBreakdown from "./ScoreBreakdown.astro";
import ScoreScale from "./ScoreScale.astro";
import SectionHeading from "./SectionHeading.astro";
import SourceList from "./SourceList.astro";
import SubdivisionTable from "./SubdivisionTable.astro";
import WorldMap from "./WorldMap.astro";

interface Props {
  locale: Locale;
  itemId: string;
}

const { locale, itemId } = Astro.props;
const visibleItems = await loadVisibleItems();
const texts = await loadItemTexts();
const reference = loadReference();
const item = visibleItems.find((i) => i.id === itemId);
const detail =
  item &&
  buildItemDetail({
    item,
    locale,
    visibleItems,
    texts,
    places: reference.places,
    subdivisions: reference.subdivisions,
  });
if (!detail) {
  throw new Error(`No ${locale} page data for item "${itemId}".`);
}

const { text, score } = detail;
const visibleIds = new Set(visibleItems.map((i) => i.id));
const hrefFor = (id: string) => {
  const target =
    texts.find((x) => x.itemId === id && x.locale === locale) ??
    texts.find((x) => x.itemId === id && x.locale === defaultLocale);
  return target && visibleIds.has(id) ? itemHref(target.locale, target.text.slug) : undefined;
};
const numbers = new Map(detail.sources.map((s) => [s.source.id, s.number]));
const bodyHtml = resolveItemLinks(
  renderCitations(await loadRenderedBody(itemId, locale), numbers),
  hrefFor,
);
const scoreLabel = format(locale, "ranking.scoreLabel", {
  score: score.score.point,
  low: score.score.low,
  high: score.score.high,
});
const since = detail.item.since;
const sinceText =
  since === undefined ? undefined : typeof since === "number" ? String(since) : `${since.min}–${since.max}`;
const rankText = format(locale, "item.rankOf", { rank: detail.rank, total: detail.total });
const evidenceTooltip = format(locale, "item.evidenceGradeTooltip", { grade: detail.evidenceGrade });
const image = detail.item.image;
const cover = image && coverImage(detail.item.id, image.file);
const hasBody = bodyHtml.trim() !== "";

/** Sections in reading order; numbers and the "on this page" list come from here. */
const sections = [
  { id: "map", title: t(locale, "item.mapTitle") },
  { id: "definition", title: t(locale, "item.definitionTitle") },
  ...(hasBody ? [{ id: "context", title: t(locale, "item.articleTitle") }] : []),
  { id: "breakdown", title: t(locale, "item.breakdownTitle") },
  { id: "sources", title: t(locale, "item.sourcesTitle") },
  ...(detail.related.length > 0 ? [{ id: "related", title: t(locale, "item.relatedTitle") }] : []),
];
const numberOf = (id: string) => sections.findIndex((s) => s.id === id) + 1;

const sheet: { label: string; value: string; href?: string; title?: string }[] = [
  { label: t(locale, "item.category"), value: categoryLabel(locale, detail.item.category) },
  { label: t(locale, "item.rank"), value: rankText },
  ...(sinceText ? [{ label: t(locale, "item.sinceLabel"), value: sinceText }] : []),
  {
    label: t(locale, "item.evidenceShort"),
    value: detail.evidenceGrade,
    href: "#evidence",
    title: evidenceTooltip,
  },
  { label: t(locale, "item.methodology"), value: `v${detail.item.methodologyVersion}` },
];

const labelClass = "font-mono text-xs tracking-widest text-gold uppercase";
---

<BaseLayout locale={locale} alternates={detail.alternates} title={text.title} description={text.summary}>
  <div slot="hero" class="mx-auto max-w-6xl px-4 pt-10 pb-12 text-center">
    <div class="flex flex-wrap justify-center gap-2">
      <Pill>{categoryLabel(locale, detail.item.category)}</Pill>
      <Pill>{rankText}</Pill>
      {detail.hiddenJabuticaba && <Pill tone="accent">{t(locale, "badge.hiddenJabuticaba")}</Pill>}
      {detail.item.status === "mock" && <Pill tone="warning">{t(locale, "badge.mock")}</Pill>}
      {detail.item.status === "draft" && <Pill tone="warning">{t(locale, "badge.draft")}</Pill>}
    </div>
    <h1 class="mx-auto mt-5 max-w-4xl font-serif text-balance text-4xl leading-tight font-semibold tracking-tight sm:text-5xl">
      {text.title}
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-band-muted">{text.summary}</p>
    {
      text.translationStatus === "machine" && (
        <p class="mt-3 text-xs text-band-muted italic">{t(locale, "item.machineTranslation")}</p>
      )
    }
    <p class="mt-6 font-mono text-xs tracking-widest text-band-gold uppercase">
      {format(locale, "item.lastReviewedShort", { date: formatPartialDate(locale, detail.item.lastReviewed) })}
    </p>
  </div>

  <main class="mx-auto max-w-6xl px-4 pt-8">
    <a
      href={localizedPath(locale, "/")}
      class="font-mono text-xs tracking-wider text-ink-muted uppercase hover:text-accent"
    >
      ← {t(locale, "nav.backToRanking")}
    </a>

    <div class="mt-6 grid gap-10 lg:grid-cols-12">
      <!--
        On phones the aside "dissolves" (display: contents) so its blocks can be
        interleaved with the article: image, score, jump-to, article, fact sheet.
        On large screens it is a normal sidebar column.
      -->
      <aside class="contents lg:order-2 lg:col-span-4 lg:flex lg:flex-col lg:gap-8">
        <section
          class="order-2 rounded-md border border-rule bg-surface-raised p-5 shadow-sm lg:order-none"
          aria-label={t(locale, "item.index")}
        >
          <p class={labelClass}>{t(locale, "item.index")}</p>
          <p class="mt-2 text-6xl font-semibold tracking-tight text-heading">
            {score.score.point}<span class="text-3xl font-normal text-ink-muted">%</span>
          </p>
          <p class="mt-1 text-sm text-ink-muted">
            {format(locale, "item.rangeLabel", { range: formatRange(locale, score.score.low, score.score.high) })}
          </p>
          <div class="mt-5 px-2">
            <ScoreScale low={score.score.low} point={score.score.point} high={score.score.high} label={scoreLabel} />
          </div>
        </section>

        {
          cover && image && (
            <figure class="order-1 lg:order-none">
              <Image
                src={cover}
                alt={text.imageAlt ?? ""}
                widths={[400, 800]}
                sizes="(min-width: 1152px) 360px, (min-width: 1024px) 31vw, 100vw"
                loading="eager"
                class="aspect-3/2 w-full rounded-md border border-rule object-cover"
              />
              <figcaption class="mt-2 text-xs text-ink-muted">
                {image.credit.url ? (
                  <a href={image.credit.url} class="hover:text-accent hover:underline" rel="noopener">
                    {format(locale, "item.imageCredit", { author: image.credit.author, license: image.credit.license })}
                  </a>
                ) : (
                  format(locale, "item.imageCredit", { author: image.credit.author, license: image.credit.license })
                )}
              </figcaption>
            </figure>
          )
        }


        <section class="order-5 lg:order-none">
          <p class={labelClass}>{t(locale, "item.sheet")}</p>
          <dl class="mt-3 divide-y divide-rule border-y border-rule text-sm">
            {
              sheet.map((row) => (
                <div class="flex justify-between gap-4 py-2">
                  <dt class="text-ink-muted">{row.label}</dt>
                  <dd class="text-right font-medium text-ink">
                    {row.href ? (
                      <a href={row.href} title={row.title} class="underline decoration-rule underline-offset-4 hover:text-accent">
                        {row.value}
                      </a>
                    ) : (
                      row.value
                    )}
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <nav class="order-3 lg:sticky lg:top-6 lg:order-none" aria-label={t(locale, "item.onThisPage")}>
          <details class="group lg:hidden">
            <summary class="cursor-pointer border-y border-rule py-3 font-mono text-xs tracking-widest text-gold uppercase">
              {t(locale, "item.jumpTo")}
            </summary>
            <ol class="mt-2 space-y-1 text-sm">
              {sections.map((s) => (
                <li><a href={`#${s.id}`} class="text-ink hover:text-accent">{s.title}</a></li>
              ))}
            </ol>
          </details>
          <div class="hidden lg:block">
            <p class={labelClass}>{t(locale, "item.onThisPage")}</p>
            <ol class="mt-3 space-y-2 border-l border-rule text-sm">
              {sections.map((s, index) => (
                <li>
                  <a href={`#${s.id}`} class="-ml-px flex gap-3 border-l border-transparent pl-4 text-ink-muted hover:border-accent hover:text-ink">
                    <span class="font-mono text-xs text-gold">{String(index + 1).padStart(2, "0")}</span>
                    {s.title}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      </aside>

      <div class="order-4 min-w-0 space-y-14 lg:order-1 lg:col-span-8">
        <section>
          <SectionHeading number={numberOf("map")} id="map">{t(locale, "item.mapTitle")}</SectionHeading>
          {detail.presence.length === 0 && <p class="mt-4 text-ink-muted">{t(locale, "item.mapAlone")}</p>}
          <div class="mt-4">
            <WorldMap locale={locale} presence={detail.presence} />
          </div>
          <PresenceTable locale={locale} rows={detail.presence} sources={detail.sources} placeCount={score.placeCount} />
          <SubdivisionTable locale={locale} rows={detail.subdivisions} sources={detail.sources} />
        </section>

        <section>
          <SectionHeading number={numberOf("definition")} id="definition">{t(locale, "item.definitionTitle")}</SectionHeading>
          <p class="mt-4 border-l-2 border-accent pl-4 font-serif text-xl leading-relaxed text-ink">
            {text.definition}
          </p>
        </section>

        {
          hasBody && (
            <section>
              <SectionHeading number={numberOf("context")} id="context">{t(locale, "item.articleTitle")}</SectionHeading>
              <div class="prose-body mt-4 max-w-2xl" set:html={bodyHtml} />
            </section>
          )
        }

        <section>
          <SectionHeading number={numberOf("breakdown")} id="breakdown">{t(locale, "item.breakdownTitle")}</SectionHeading>
          <ScoreBreakdown detail={detail} />
        </section>

        <section>
          <SectionHeading number={numberOf("sources")} id="sources">{t(locale, "item.sourcesTitle")}</SectionHeading>
          <SourceList locale={locale} sources={detail.sources} />
        </section>

        {
          detail.related.length > 0 && (
            <section>
              <SectionHeading number={numberOf("related")} id="related">{t(locale, "item.relatedTitle")}</SectionHeading>
              <ul class="mt-4 flex flex-wrap gap-2">
                {detail.related.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      lang={link.lang}
                      class="inline-block rounded-sm border border-rule px-3 py-1.5 font-serif text-base text-heading hover:border-accent hover:text-accent"
                    >
                      {link.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </main>
</BaseLayout>
