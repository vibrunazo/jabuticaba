---
/** Mark (jabuticabas growing straight on the trunk, as they do) plus wordmark. Drawn on the dark band. */
import { type Locale, localizedPath, t } from "../i18n/ui.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const name = t(locale, "site.name").replace("®", "");
---

<a href={localizedPath(locale, "/")} class="group flex items-center gap-2.5 text-band-ink">
  <svg class="size-8 shrink-0" viewBox="0 0 32 32" aria-hidden="true">
    <rect x="14" y="0" width="4.5" height="32" rx="2" class="fill-band-muted opacity-50"></rect>
    <circle cx="9" cy="9" r="6" class="fill-band-berry"></circle>
    <circle cx="23.5" cy="16" r="6" class="fill-band-berry"></circle>
    <circle cx="9.5" cy="24" r="5.5" class="fill-band-berry"></circle>
    <circle cx="7" cy="7" r="1.6" class="fill-band-ink opacity-60"></circle>
    <circle cx="21.5" cy="14" r="1.6" class="fill-band-ink opacity-60"></circle>
    <circle cx="7.5" cy="22" r="1.4" class="fill-band-ink opacity-60"></circle>
  </svg>
  <span class="font-serif text-xl font-semibold tracking-tight group-hover:text-band-gold">
    {name}<sup class="ml-0.5 font-sans text-xs font-normal">®</sup>
  </span>
</a>
