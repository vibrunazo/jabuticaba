---
/** Numbered section title, in the style of a report: "02  Where else it exists". */
interface Props {
  number: number;
  id: string;
  /** Extra classes, e.g. to drop the top rule where something above already separates. */
  class?: string;
}

const { number, id, class: className } = Astro.props;
---

<h2 id={id} class:list={["flex scroll-mt-6 items-baseline gap-3 border-t border-rule pt-4", className]}>
  <span class="font-mono text-xs tabular-nums text-gold">{String(number).padStart(2, "0")}</span>
  <span class="font-serif text-2xl font-semibold tracking-tight text-heading"><slot /></span>
</h2>
