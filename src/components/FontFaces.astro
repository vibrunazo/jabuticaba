---
/**
 * Web fonts, declared here instead of through the Fontsource CSS so that:
 * 1. the three fonts used above the fold are preloaded from <head>, so they download
 *    in parallel with the CSS instead of after it;
 * 2. `font-display: optional` replaces Fontsource's `swap`: the browser waits briefly
 *    for the font and, if it is not ready, keeps the fallback for that page view.
 *    Text never reflows mid-page (no flash of re-laid-out text).
 * Only the latin and latin-ext subsets are declared; Portuguese needs latin only.
 * The `?url` imports give the final (hashed) file URLs in both dev and build.
 */

import monoLatin400 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import monoLatin500 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url";
import monoLatinExt400 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-ext-400-normal.woff2?url";
import monoLatinExt500 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-ext-500-normal.woff2?url";
import sansLatinExt from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-ext-wght-normal.woff2?url";
import sansLatin from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import serifItalicLatinExt from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-ext-opsz-italic.woff2?url";
import serifLatinExt from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-ext-opsz-normal.woff2?url";
import serifItalicLatin from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-italic.woff2?url";
import serifLatin from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url";

/** Unicode ranges copied from the Fontsource CSS of each subset. */
const LATIN =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
const LATIN_EXT =
  "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF";

interface Face {
  family: string;
  style: "normal" | "italic";
  weight: string;
  url: string;
  format: "woff2" | "woff2-variations";
  range: string;
}

const SERIF = "Source Serif 4 Variable";
const SANS = "IBM Plex Sans Variable";
const MONO = "IBM Plex Mono";

const faces: Face[] = [
  { family: SERIF, style: "normal", weight: "200 900", url: serifLatin, format: "woff2-variations", range: LATIN },
  { family: SERIF, style: "normal", weight: "200 900", url: serifLatinExt, format: "woff2-variations", range: LATIN_EXT },
  { family: SERIF, style: "italic", weight: "200 900", url: serifItalicLatin, format: "woff2-variations", range: LATIN },
  { family: SERIF, style: "italic", weight: "200 900", url: serifItalicLatinExt, format: "woff2-variations", range: LATIN_EXT },
  { family: SANS, style: "normal", weight: "100 700", url: sansLatin, format: "woff2-variations", range: LATIN },
  { family: SANS, style: "normal", weight: "100 700", url: sansLatinExt, format: "woff2-variations", range: LATIN_EXT },
  { family: MONO, style: "normal", weight: "400", url: monoLatin400, format: "woff2", range: LATIN },
  { family: MONO, style: "normal", weight: "400", url: monoLatinExt400, format: "woff2", range: LATIN_EXT },
  { family: MONO, style: "normal", weight: "500", url: monoLatin500, format: "woff2", range: LATIN },
  { family: MONO, style: "normal", weight: "500", url: monoLatinExt500, format: "woff2", range: LATIN_EXT },
];

/** Used on every page above the fold. Italic, latin-ext and mono 500 load on demand. */
const preloads = [serifLatin, sansLatin, monoLatin400];

const css = faces
  .map(
    (face) =>
      `@font-face{font-family:'${face.family}';font-style:${face.style};font-weight:${face.weight};font-display:optional;src:url(${face.url}) format('${face.format}');unicode-range:${face.range};}`,
  )
  .join("\n");
---

{preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<style is:inline set:html={css} />
