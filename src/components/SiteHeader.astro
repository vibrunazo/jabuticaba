---
/**
 * Site navigation, drawn on the dark band (see BaseLayout.astro).
 * On phones the links drop their letter-spacing so the nav fits on one row.
 */
import { pagePath } from "../i18n/routes.ts";
import { defaultLocale, type Locale, locales, localizedPath, t } from "../i18n/ui.ts";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  /** The same page in each locale that has it, e.g. { pt: "/", en: "/en/" }. */
  alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const otherLocale = locales.find((l) => l !== locale) ?? defaultLocale;
const otherHref = alternates[otherLocale] ?? localizedPath(otherLocale, "/");
---

<header class="border-b border-band-rule">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4">
    <div>
      <Logo locale={locale} />
      <p class="mt-1 pl-10.5 text-xs text-band-muted">{t(locale, "site.tagline")}</p>
    </div>
    <nav class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-band-muted sm:gap-x-5">
      <a
        href={localizedPath(locale, "/")}
        class="font-mono text-xs whitespace-nowrap uppercase hover:text-band-ink sm:tracking-wider"
      >
        {t(locale, "nav.backToRanking")}
      </a>
      <a
        href={pagePath(locale, "methodology")}
        class="font-mono text-xs whitespace-nowrap uppercase hover:text-band-ink sm:tracking-wider"
      >
        {t(locale, "nav.methodology")}
      </a>
      <ThemeToggle locale={locale} />
      <a
        href={otherHref}
        hreflang={otherLocale}
        lang={otherLocale}
        class="rounded-sm border border-band-rule px-2 py-0.5 font-mono text-xs hover:border-band-muted hover:text-band-ink"
      >
        {t(locale, "nav.switchLanguage")}
      </a>
    </nav>
  </div>
</header>
