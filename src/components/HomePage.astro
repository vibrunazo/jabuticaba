---
import { format, type Locale, t } from "../i18n/ui.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { METHODOLOGY_VERSION } from "../scoring/constants.ts";
import { includeUnpublished, loadItems, loadItemTexts } from "../site/content.ts";
import { buildRanking } from "../site/ranking.ts";
import RankingRow from "./RankingRow.astro";
import ScoreErrorBar from "./ScoreErrorBar.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const rows = buildRanking(await loadItems(), await loadItemTexts(), locale, {
  includeUnpublished,
});
---

<BaseLayout locale={locale} alternates={{ pt: "/", en: "/en/" }}>
  <main class="mx-auto max-w-4xl px-4 pt-12">
    <p class="font-mono text-xs uppercase tracking-wider text-accent">
      {format(locale, "ranking.eyebrow", { version: METHODOLOGY_VERSION, count: rows.length })}
    </p>
    <h1 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-heading sm:text-4xl">
      {t(locale, "ranking.title")}
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-muted">{t(locale, "ranking.intro")}</p>

    <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-ink-muted" aria-hidden="true">
      <span class="inline-block w-20">
        <ScoreErrorBar low={25} point={50} high={75} label="" />
      </span>
      <span class="flex items-center gap-1.5">
        <span class="inline-block size-2.5 rounded-full bg-accent"></span>
        {t(locale, "ranking.legendPoint")}
      </span>
      <span class="flex items-center gap-1.5">
        <span class="font-mono text-ink">|—|</span>
        {t(locale, "ranking.legendRange")}
      </span>
    </div>

    {
      rows.length > 0 ? (
        <ol class="mt-4 border-t border-rule">
          {rows.map((row) => (
            <RankingRow row={row} locale={locale} />
          ))}
        </ol>
      ) : (
        <p class="mt-8 border-t border-rule pt-6 text-ink-muted">{t(locale, "ranking.empty")}</p>
      )
    }
  </main>
</BaseLayout>
