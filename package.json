{
  "name": "jabuticaba",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Jabuticaba Index: a rigorous, reproducible measure of how Brazilian things are.",
  "license": "CC0-1.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate.ts --production && astro build",
    "build:preview": "astro build --mode preview",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate.ts",
    "index": "node scripts/compute-index.ts",
    "schema": "node scripts/generate-json-schema.ts",
    "verify": "biome check . && astro check && vitest run && node scripts/validate.ts && node scripts/generate-json-schema.ts --check && node scripts/compute-index.ts --check && node scripts/build-geo.ts --check && astro build",
    "geo": "node scripts/build-geo.ts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "d3-geo": "^3.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.14",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.6",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "i18n-iso-countries": "^7.14.0",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "world-atlas": "^2.0.2"
  }
}
