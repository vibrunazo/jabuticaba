{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../../schemas/item.schema.json"
    },
    "id": {
      "type": "string",
      "maxLength": 60,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "mock",
        "draft",
        "published"
      ]
    },
    "methodologyVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "lastReviewed": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "category": {
      "type": "string",
      "enum": [
        "nature",
        "food",
        "home",
        "urban",
        "culture",
        "politics",
        "justice",
        "economy"
      ]
    },
    "since": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        }
      ]
    },
    "presence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "place": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "level": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "absent",
                  "marginal",
                  "regional",
                  "widespread"
                ]
              },
              {
                "type": "array",
                "items": [
                  {
                    "type": "string",
                    "enum": [
                      "absent",
                      "marginal",
                      "regional",
                      "widespread"
                    ]
                  },
                  {
                    "type": "string",
                    "enum": [
                      "absent",
                      "marginal",
                      "regional",
                      "widespread"
                    ]
                  }
                ],
                "additionalItems": false,
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "exported": {
            "type": "boolean",
            "const": true
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 60,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "editorial": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "place",
          "level",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "subdivisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subdivision": {
            "type": "string",
            "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
          },
          "level": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "absent",
                  "marginal",
                  "regional",
                  "widespread"
                ]
              },
              {
                "type": "array",
                "items": [
                  {
                    "type": "string",
                    "enum": [
                      "absent",
                      "marginal",
                      "regional",
                      "widespread"
                    ]
                  },
                  {
                    "type": "string",
                    "enum": [
                      "absent",
                      "marginal",
                      "regional",
                      "widespread"
                    ]
                  }
                ],
                "additionalItems": false,
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 60,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "editorial": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "subdivision",
          "level",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "intensity": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "object",
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                },
                "max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            }
          ]
        },
        "ratio": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "object",
              "properties": {
                "min": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "editorial": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "value",
        "sources"
      ],
      "additionalProperties": false
    },
    "awareness": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "object",
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                },
                "max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "editorial": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "value",
        "sources"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "dataset",
              "government",
              "academic",
              "organization",
              "reference",
              "news",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "archiveUrl": {
            "type": "string",
            "format": "uri"
          },
          "published": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          },
          "accessed": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "publisher",
          "url",
          "accessed",
          "language"
        ],
        "additionalProperties": false
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 60,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "$schema",
    "id",
    "status",
    "methodologyVersion",
    "lastReviewed",
    "category",
    "presence",
    "intensity",
    "awareness",
    "sources"
  ],
  "additionalProperties": false
}
